# ==========================================
# .gitignore - Farmer Benefit ML Project
# ==========================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Jupyter Notebooks
.ipynb_checkpoints
*-checkpoint.ipynb
.virtual_documents/

# Datasets & Large Files
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/external/*
!data/external/.gitkeep
data/annotations/*
!data/annotations/.gitkeep
!data/annotations/benchmark_v1.0.4/**
!data/annotations/benchmark_v1.0.4/
!data/annotations/benchmark_v1.1/**
!data/annotations/benchmark_v1.1/
!data/annotations/benchmark_v1.2/**
!data/annotations/benchmark_v1.2/

# Large binary / data dumps
*.tsv
*.parquet
*.feather
*.h5
*.hdf5
*.tar.gz
*.zip
*.7z

# Explicit data whitelisting for benchmarks and annotations
!data/annotations/benchmark_v1.0.4/*.csv
!data/annotations/benchmark_v1.1/*.csv
!data/annotations/benchmark_v1.2/*.csv
!data/annotations/benchmark_v1.2/raw/*.csv

# Retain scheme database assets
scheme_database/raw/*
!scheme_database/raw/.gitkeep
!scheme_database/raw/*.json
scheme_database/processed/*
!scheme_database/processed/.gitkeep
!scheme_database/processed/scheme_master.json
!scheme_database/processed/scheme_master.csv
!scheme_database/scheme_master.xlsx

# ML Models and Artifacts
models/*
!models/.gitkeep
*.pt
*.pth
*.pickle
*.onnx
*.bin
*.weights
checkpoints/

# Explicit whitelist for trained benchmark models and training labels
!data/benchmarks/**/model_*.joblib
!data/benchmarks/**/training_labels_*.csv

# Evaluation Reports, Logs, and Test caches
logs/
*.log
test_output.txt
test_results.txt
.coverage
.pytest_cache/
.mypy_cache/
.ruff_cache/
reports/*.pdf
reports/*.docx

# IDE & Editor Files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
